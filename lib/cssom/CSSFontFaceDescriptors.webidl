
// https://drafts.csswg.org/css-fonts-4/#cssfontfacedescriptors
[Exposed=Window]
interface CSSFontFaceDescriptors : CSSStyleDeclaration {
    [ReflectStyle="ascent-override"] attribute [LegacyNullToEmptyString] CSSOMString ascentOverride;
    [ReflectStyle="ascent-override"] attribute [LegacyNullToEmptyString] CSSOMString ascent-override;
    [ReflectStyle="descent-override"] attribute [LegacyNullToEmptyString] CSSOMString descentOverride;
    [ReflectStyle="descent-override"] attribute [LegacyNullToEmptyString] CSSOMString descent-override;
    [ReflectStyle="font-display"] attribute [LegacyNullToEmptyString] CSSOMString fontDisplay;
    [ReflectStyle="font-display"] attribute [LegacyNullToEmptyString] CSSOMString font-display;
    [ReflectStyle="font-family"] attribute [LegacyNullToEmptyString] CSSOMString fontFamily;
    [ReflectStyle="font-family"] attribute [LegacyNullToEmptyString] CSSOMString font-family;
    [ReflectStyle="font-feature-settings"] attribute [LegacyNullToEmptyString] CSSOMString fontFeatureSettings;
    [ReflectStyle="font-feature-settings"] attribute [LegacyNullToEmptyString] CSSOMString font-feature-settings;
    [ReflectStyle="font-language-override"] attribute [LegacyNullToEmptyString] CSSOMString fontLanguageOverride;
    [ReflectStyle="font-language-override"] attribute [LegacyNullToEmptyString] CSSOMString font-language-override;
    [ReflectStyle="font-named-instance"] attribute [LegacyNullToEmptyString] CSSOMString fontNamedInstance;
    [ReflectStyle="font-named-instance"] attribute [LegacyNullToEmptyString] CSSOMString font-named-instance;
    [ReflectStyle="font-size"] attribute [LegacyNullToEmptyString] CSSOMString fontSize;
    [ReflectStyle="font-size"] attribute [LegacyNullToEmptyString] CSSOMString font-size;
    [ReflectStyle="font-style"] attribute [LegacyNullToEmptyString] CSSOMString fontStyle;
    [ReflectStyle="font-style"] attribute [LegacyNullToEmptyString] CSSOMString font-style;
    [ReflectStyle="font-variation-settings"] attribute [LegacyNullToEmptyString] CSSOMString fontVariationSettings;
    [ReflectStyle="font-variation-settings"] attribute [LegacyNullToEmptyString] CSSOMString font-variation-settings;
    [ReflectStyle="font-weight"] attribute [LegacyNullToEmptyString] CSSOMString fontWeight;
    [ReflectStyle="font-weight"] attribute [LegacyNullToEmptyString] CSSOMString font-weight;
    [ReflectStyle="font-width"] attribute [LegacyNullToEmptyString] CSSOMString fontWidth;
    [ReflectStyle="font-width"] attribute [LegacyNullToEmptyString] CSSOMString font-width;
    [ReflectStyle="line-gap-override"] attribute [LegacyNullToEmptyString] CSSOMString lineGapOverride;
    [ReflectStyle="line-gap-override"] attribute [LegacyNullToEmptyString] CSSOMString line-gap-override;
    [ReflectStyle="size-adjust"] attribute [LegacyNullToEmptyString] CSSOMString sizeAdjust;
    [ReflectStyle="size-adjust"] attribute [LegacyNullToEmptyString] CSSOMString size-adjust;
    [ReflectStyle="src"] attribute [LegacyNullToEmptyString] CSSOMString src;
    [ReflectStyle="subscript-position-override"] attribute [LegacyNullToEmptyString] CSSOMString subscriptPositionOverride;
    [ReflectStyle="subscript-position-override"] attribute [LegacyNullToEmptyString] CSSOMString subscript-position-override;
    [ReflectStyle="subscript-size-override"] attribute [LegacyNullToEmptyString] CSSOMString subscriptSizeOverride;
    [ReflectStyle="subscript-size-override"] attribute [LegacyNullToEmptyString] CSSOMString subscript-size-override;
    [ReflectStyle="superscript-position-override"] attribute [LegacyNullToEmptyString] CSSOMString superscriptPositionOverride;
    [ReflectStyle="superscript-position-override"] attribute [LegacyNullToEmptyString] CSSOMString superscript-position-override;
    [ReflectStyle="superscript-size-override"] attribute [LegacyNullToEmptyString] CSSOMString superscriptSizeOverride;
    [ReflectStyle="superscript-size-override"] attribute [LegacyNullToEmptyString] CSSOMString superscript-size-override;
    [ReflectStyle="unicode-range"] attribute [LegacyNullToEmptyString] CSSOMString unicodeRange;
    [ReflectStyle="unicode-range"] attribute [LegacyNullToEmptyString] CSSOMString unicode-range;
    [ReflectStyle="font-stretch"] attribute [LegacyNullToEmptyString] CSSOMString fontStretch;
    [ReflectStyle="font-stretch"] attribute [LegacyNullToEmptyString] CSSOMString font-stretch;
};
