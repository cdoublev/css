{
  "name": "@cdoublev/css",
  "description": "CSS Object Model and parser implementation in JavaScript",
  "author": "Guillaume Lebas",
  "license": "MIT",
  "keywords": [
    "CSS"
  ],
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/cdoublev/css#readme",
  "bugs": "https://github.com/cdoublev/css/issues",
  "repository": "github:cdoublev/css",
  "directories": {
    "doc": "doc",
    "lib": "./lib",
    "test": "test"
  },
  "files": [
    "lib",
    "index.js"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "build": "npm run build:interface && npm run build:definitions",
    "build:definitions": "npm run build:definitions:extract && npm run build:definitions:normalize",
    "build:definitions:extract": "node ./scripts/extract.js",
    "build:definitions:normalize": "node ./scripts/normalize.js",
    "build:directionality": "node ./scripts/directionality.js",
    "build:interface": "node ./scripts/interface.js",
    "lint": "eslint",
    "safe-publish": "npm run build && npm run lint && npm run test && npm publish",
    "test": "NODE_ENV=test node --test",
    "test:inspect": "npm run test -- --watch --inspect-wait=0.0.0.0:9222 --no-warnings",
    "test:watch": "npm run test -- --watch"
  },
  "dependencies": {
    "undici": "^8.0.0"
  },
  "devDependencies": {
    "@cdoublev/eslint-config": "^0.13.0",
    "webidl2js": "cdoublev/webidl2js#es-module",
    "webref": "w3c/webref#18d603ecda27e6fc7b8b755e9d9e6a12d8a04ce2"
  },
  "publishConfig": {
    "access": "public"
  }
}
